# Malli ympäristömuuttujista eli asetuksista, jotka ovat salaisia
# eivätkä siksi kuulu versionhallintaan.
#
# Käyttö: kopioi tämä tiedosto nimelle .env ja täytä omat arvot.
#   cp .env.example .env
#
# Oikeaa .env-tiedostoa ei koskaan viedä repoon (se on .gitignoressa).

# Tietokannan osoite. Projektissa käytetään PostgreSQL-tietokantaa
# Neon-palvelussa. Arvo saadaan Neonin hallintapaneelista kohdasta
# "Connection string". Valitse "Pooled connection": sovellus käynnistyy
# palvelimella monta kertaa rinnakkain, ja yhteysallas estää yhteyksien
# loppumisen.
#
# Käytä lopussa sslmode=verify-full äläkä sslmode=require. Molemmat
# salaavat liikenteen, mutta verify-full tarkistaa lisäksi palvelimen
# varmenteen, eli varmistaa että yhteys menee oikeaan tietokantaan
# eikä välissä olevalle huijarille.
DATABASE_URL="postgresql://kayttaja:salasana@osoite/tietokanta?sslmode=verify-full"

# Ensimmäisen ylläpitäjän tunnukset. Nämä luetaan vain kerran, kun
# tietokanta alustetaan komennolla "npm run db:seed". Salasanaa ei
# kirjoiteta koodiin, jotta se ei päädy versionhallintaan.
# Vähimmäispituus on 10 merkkiä.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Satunnainen salasana, jolla kirjautumistiedot allekirjoitetaan.
# Luo oma arvo komennolla: openssl rand -base64 32
# Otetaan käyttöön vaiheessa 5.
AUTH_SECRET=""

# Sovelluksen julkinen osoite. Paikallisesti kehitettäessä localhost,
# tuotannossa Vercelin antama osoite.
AUTH_URL="http://localhost:3000"

# Pörssisähkön hintarajapinnan osoite. Oletuksena avoin porssisahko.net.
# Otetaan käyttöön vaiheessa 7.
PRICE_API_URL="https://api.porssisahko.net/v2"
