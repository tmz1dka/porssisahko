  "private": true,
  "description": "Sovellus, joka etsii kotitalouden laitteille halvimman sähkönkäyttöajan pörssisähkön hintojen perusteella.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
