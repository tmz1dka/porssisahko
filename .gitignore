# Riippuvuudet, jotka asennetaan komennolla npm install
node_modules/

# Ympäristömuuttujat eli salaiset asetukset (tietokannan osoite, salasanat).
# Repoon tulee vain malli .env.example.
.env
.env*.local

# Next.jsin kääntämät tiedostot ja rakennustulokset
.next/
out/
build/

# Käyttöjärjestelmän ja editorin omat apu- ja väliaikaistiedostot
.DS_Store
*.log
coverage/

# TypeScriptin oma välimuistitiedosto (syntyy itsestään, ei kuulu repoon)
*.tsbuildinfo

# Next.jsin luoma tyyppitiedosto. Next kirjoittaa sen eri sisällöllä
# riippuen siitä, ajetaanko "npm run dev" vai "npm run build", joten
# repoon tallennettu versio olisi jatkuvasti väärä. Se syntyy itsestään.
next-env.d.ts

# Vercelin paikalliset asetukset
.vercel

# Prisman koneellisesti luoma tietokanta-asiakas. Syntyy komennolla
# "prisma generate", joka ajetaan automaattisesti npm installin jälkeen.
/src/generated/
